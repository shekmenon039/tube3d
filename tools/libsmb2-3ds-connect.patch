+/*
+ * The result of a non-blocking connect: 0 connected, 1 failed (*err set), 2 still connecting.
+ * On the 3DS, SO_ERROR reports the raw "in progress" code (-26) even when poll() already says
+ * the socket is writable: there, whether the peer can be named decides.
+ */
+static int
+smb2_connect_result(t_socket fd, int *err)
+{
+        socklen_t err_size = sizeof(*err);
+
+        *err = 0;
+        if (getsockopt(fd, SOL_SOCKET, SO_ERROR, (char *)err, &err_size) != 0) {
+                *err = errno;
+                return 1;
+        }
+#ifdef __3DS__
+        if (*err == -26 || *err == 26 || *err == EINPROGRESS) {
+                struct sockaddr_storage peer;
+                socklen_t peer_len = sizeof(peer);
+
+                if (getpeername(fd, (struct sockaddr *)&peer, &peer_len) == 0) {
+                        *err = 0;
+                        return 0;
+                }
+                return 2;
+        }
+#endif
+        return *err != 0 ? 1 : 0;
+}
