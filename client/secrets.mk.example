# Copy to client/secrets.mk (ignored by git, never commit it) and put your key in.
#
# YouTube Data API v3 key, used only to read public video data (whether an upload is marked
# 3D). Create it in the Google Cloud console: enable "YouTube Data API v3", then
# Credentials -> Create credentials -> API key, choosing "Public data". In the console:
#   - restrict the key to "YouTube Data API v3" (API restrictions)
#   - lower its daily quota if you like (APIs & Services -> YouTube Data API v3 -> Quotas)
# Anyone holding the .cia can read the key out of it: the restrictions above are what keep a
# leaked key harmless (it can only spend this project's free daily quota).
YT_DATA_API_KEY :=
