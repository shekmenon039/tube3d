# makerom spec for the Tube3D CIA, used by make -C client cia.
# It grants access to mvd:STD, the New 3DS hardware H.264 decoder, and depends on its sysmodule.

BasicInfo:
  Title                   : $(APP_RSF_TITLE)
  ProductCode             : CTR-H-T3DV
  Logo                    : Homebrew

TitleInfo:
  Category                : Application
  UniqueId                : $(APP_UNIQUE_ID)   # 0xF3D30 (client/Makefile)

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion                   : 2
  DescVersion                   : 2
  # Kernel 2.44 or later puts linear memory at 0x30000000, the layout system modules expect.
  # Declaring 2.33 gives the old 0x14000000 layout, and the MVD module crashes reading our buffers.
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "44"
  UseExtSaveData                : false
  FileSystemAccess:
   - DirectSdmc
   - DirectSdmcWrite
  MemoryType                    : Application
  SystemMode                    : 64MB
  SystemModeExt                 : 124MB
  CpuSpeed                      : 804MHz
  EnableL2Cache                 : true
  CanAccessCore2                : true
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0x9E
  HandleTableSize               : 0x200
  DisableDebug                  : true    # no debugger can attach to a release build
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # ndsp writes to DSP shared memory directly, so without this mapping ndspInit() data-aborts
  IORegisterMapping:
   - 1ff00000-1ff7ffff   # DSP memory
  MemoryMapping:
   - 1f000000-1f5fffff:r # VRAM

  # Least privilege: the app gets only the calls and services its code actually uses. That
  # leaves out svcBackdoor and KernelSetState (both run kernel code), inter-process DMA,
  # OpenProcess and QueryProcessMemory, the server-side IPC and interrupt calls, and services
  # it never touches - am:net could install or delete titles, cfg:nor writes config flash, and
  # pxi, nwm, ir, mic, camera and friends aren't needed either. TLS is done by mbedTLS inside
  # the app, so ssl:C and http:C stay out too. If a new feature needs a service, add it here
  # with a comment saying which call uses it.
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessAffinityMask: 4
    SetProcessAffinityMask: 5
    GetProcessIdealProcessor: 6
    SetProcessIdealProcessor: 7
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadAffinityMask: 13
    SetThreadAffinityMask: 14
    GetThreadIdealProcessor: 15
    SetThreadIdealProcessor: 16
    GetCurrentProcessorNumber: 17
    Run: 18
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    SignalAndWait: 38
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    Break: 60
    InvalidateProcessDataCache: 82
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84

  InterruptNumbers:

  # What each service is for: APT; gsp for graphics and the LCD backlight; hid; fs for the SD
  # card; soc and ac for the network and Wi-Fi state; dsp for ndsp audio; mvd for hardware
  # H.264; ptm:u and mcu::HWC for the battery; ptm:sysm for osSetSpeedupEnable (804 MHz and
  # the L2 cache); cfg:u to read the system settings.
  ServiceAccessControl:
   - APT:U
   - ac:u
   - cfg:u
   - dsp::DSP
   - fs:USER
   - gsp::Gpu
   - gsp::Lcd
   - hid:USER
   - mcu::HWC
   - mvd:STD
   - ptm:sysm
   - ptm:u
   - soc:U

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x40000
  Dependency:
    ac: 0x0004013000002402L
    am: 0x0004013000001502L
    boss: 0x0004013000003402L
    camera: 0x0004013000001602L
    cecd: 0x0004013000002602L
    cfg: 0x0004013000001702L
    codec: 0x0004013000001802L
    csnd: 0x0004013000002702L
    dlp: 0x0004013000002802L
    dsp: 0x0004013000001a02L
    friends: 0x0004013000003202L
    gpio: 0x0004013000001b02L
    gsp: 0x0004013000001c02L
    hid: 0x0004013000001d02L
    http: 0x0004013000002902L
    i2c: 0x0004013000001e02L
    ir: 0x0004013000003302L
    mcu: 0x0004013000001f02L
    mic: 0x0004013000002002L
    mvd: 0x0004013020004102L
    ndm: 0x0004013000002b02L
    news: 0x0004013000003502L
    nim: 0x0004013000002c02L
    nwm: 0x0004013000002d02L
    pdn: 0x0004013000002102L
    ps: 0x0004013000003102L
    ptm: 0x0004013000002202L
    ro: 0x0004013000003702L
    socket: 0x0004013000002e02L
    spi: 0x0004013000002302L
    ssl: 0x0004013000002f02L
